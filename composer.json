{
    "name": "badinansoft/nova-tooltip",
    "description": "A Laravel Nova tool.",
    "keywords": [
        "laravel",
        "nova"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "laravel/nova": "^5.0",
        "laravel/nova-devtool": "^1.7"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://gitlab.elnino.tech/elnino/laravel-nova"
        }
    ],
    "autoload": {
        "psr-4": {
            "Test\\Test\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Test\\Test\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}